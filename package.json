{
  "name": "shopify-clothing-banner",
  "version": "0.1.0",
  "description": "A hanging clothes-rail banner for Shopify storefronts. Garments swing on hangers with spring and pendulum physics.",
  "keywords": [
    "shopify",
    "storefront",
    "react",
    "banner",
    "hero",
    "clothing",
    "physics",
    "animation"
  ],
  "license": "MIT",
  "author": "Moe Ghashim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeghashim/shopify-clothing-banner.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/clothing-rack.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "vite build --config demo/vite.config.ts",
    "dev": "vite --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "video": "node video/record.mjs && python3 video/compose.py"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
